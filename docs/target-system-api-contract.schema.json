{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/target-system-api-contract.schema.json",
  "title": "脱敏目标系统 API 契约",
  "type": "object",
  "required": ["authentication", "response_envelope", "endpoints"],
  "properties": {
    "authentication": {
      "type": "object",
      "properties": {"header": {"const": "Authorization"}, "format": {"const": "unknown"}},
      "required": ["header", "format"]
    },
    "response_envelope": {
      "type": "object",
      "properties": {
        "code": {"type": "integer"},
        "message": {"type": ["string", "null"]},
        "msg": {"type": ["string", "null"]},
        "data": {}
      },
      "required": ["code", "data"]
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
